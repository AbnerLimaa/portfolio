---
import ThemeToggle from '@/components/ThemeToggle.astro';
import LanguageToggle from '@/components/LanguageToggle.astro';
import { SITE, NAV_LINKS, NAV_LINKS_PT_BR } from '@/site.config';

const currentPath = Astro.url.pathname;
const isPtBr = currentPath.startsWith('/pt-br/') || currentPath === '/pt-br';
const currentNavLinks = isPtBr ? NAV_LINKS_PT_BR : NAV_LINKS;
---

<header id="main-header" class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur transition-transform duration-300 ease-in-out">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href={isPtBr ? "/pt-br" : "/"} class="font-display text-ink text-lg font-medium">
      {SITE.name}
    </a>

    <div class="flex items-center gap-3 md:gap-5">
      <nav class="hidden md:flex items-center gap-5" aria-label="Primary">
        {
          currentNavLinks.map((link) => {
            const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
            return (
              <a
                href={link.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'font-mono text-xs tracking-wide uppercase transition-colors',
                  isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
        <a
          href={isPtBr ? "/pt-br/#contact" : "/#contact"}
          class="text-ink-soft hover:text-ink font-mono text-xs tracking-wide uppercase transition-colors"
        >
          {isPtBr ? "Contato" : "Contact"}
        </a>
      </nav>
      
      <div class="flex items-center gap-3">
        <ThemeToggle />
        <LanguageToggle />
        
        <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center text-ink-soft hover:text-ink transition-colors p-1" aria-label="Toggle menu" aria-expanded="false">
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <line x1="3" x2="21" y1="12" y2="12"></line>
            <line x1="3" x2="21" y1="18" y2="18"></line>
          </svg>
          <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" x2="6" y1="6" y2="18"></line>
            <line x1="6" x2="18" y1="6" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="absolute left-0 top-full hidden w-full h-[100dvh] flex-col bg-paper md:hidden overflow-y-auto pb-24">
    <nav class="flex flex-col" aria-label="Mobile">
      {
        currentNavLinks.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'mobile-nav-link border-line border-b px-6 py-6 font-mono text-sm tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href={isPtBr ? "/pt-br/#contact" : "/#contact"}
        class="mobile-nav-link border-line border-b px-6 py-6 font-mono text-sm tracking-wide uppercase text-ink-soft hover:text-ink transition-colors"
      >
        {isPtBr ? "Contato" : "Contact"}
      </a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const links = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');
    const header = document.getElementById('main-header');

    if (!btn) return;

    let lastScrollY = window.scrollY;
    header?.classList.remove('-translate-y-full');

    function toggleMenu() {
      const isExpanded = btn?.getAttribute('aria-expanded') === 'true';
      btn?.setAttribute('aria-expanded', (!isExpanded).toString());
      
      if (isExpanded) {
        menu?.classList.add('hidden');
        menu?.classList.remove('flex');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        document.body.style.overflow = '';
      } else {
        menu?.classList.remove('hidden');
        menu?.classList.add('flex');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    btn.addEventListener('click', toggleMenu);
    
    links.forEach(link => {
      link.addEventListener('click', () => {
        if (btn?.getAttribute('aria-expanded') === 'true') {
          const url = new URL(link.href);
          if (url.pathname === window.location.pathname) {
            toggleMenu();
          } else {
            document.body.style.overflow = '';
          }
        }
      });
    });

    window.addEventListener('scroll', () => {
      if (btn?.getAttribute('aria-expanded') === 'true') return;

      const currentScrollY = window.scrollY;
      
      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        header?.classList.add('-translate-y-full');
      } else {
        header?.classList.remove('-translate-y-full');
      }
      
      lastScrollY = currentScrollY;
    }, { passive: true });
  });
</script>
