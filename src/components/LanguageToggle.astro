---
const currentPath = Astro.url.pathname;
const isPtBr = currentPath.startsWith('/pt-br/') || currentPath === '/pt-br';
let basePath = currentPath;

if (isPtBr) {
  basePath = currentPath.replace(/^\/pt-br\/?/, '/');
  if (!basePath.startsWith('/')) {
    basePath = '/' + basePath;
  }
}

const enUrl = basePath;
const ptBrUrl = basePath === '/' ? '/pt-br' : `/pt-br${basePath.startsWith('/') ? basePath : `/${basePath}`}`;

const languages = [
  { code: 'en-US', label: 'English', href: enUrl },
  { code: 'pt-BR', label: 'Português', href: ptBrUrl }
];
---

<div class="relative" id="lang-toggle-container">
  <button
    id="lang-toggle-btn"
    type="button"
    aria-label="Change language"
    aria-expanded="false"
    class="text-ink-soft hover:border-signal hover:text-signal border-line flex h-9 w-9 shrink-0 items-center justify-center rounded-full border transition-colors"
  >
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      <path d="M2 12h20"></path>
    </svg>
  </button>

  <div id="lang-dropdown" class="absolute right-0 top-full pt-2 hidden z-50">
    <div class="flex flex-col overflow-hidden rounded-md border border-line bg-paper shadow-sm">
      {languages.map((lang) => (
        <a
          href={lang.href}
          data-lang-code={lang.code.startsWith('en') ? 'en' : 'pt-br'}
          class="px-4 py-2 text-sm font-mono tracking-wide text-ink-soft hover:bg-surface hover:text-ink whitespace-nowrap transition-colors lang-link"
        >
          {lang.code}
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('lang-toggle-btn');
    const dropdown = document.getElementById('lang-dropdown');
    const links = document.querySelectorAll('.lang-link');
    
    if (!btn || !dropdown) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        btn.setAttribute('aria-expanded', 'false');
        dropdown.classList.add('hidden');
        dropdown.classList.remove('flex');
      } else {
        btn.setAttribute('aria-expanded', 'true');
        dropdown.classList.remove('hidden');
        dropdown.classList.add('flex');
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target;
      // Close dropdown if click is outside
      if (target instanceof Node && !dropdown.contains(target) && btn.getAttribute('aria-expanded') === 'true') {
        btn.setAttribute('aria-expanded', 'false');
        dropdown.classList.add('hidden');
        dropdown.classList.remove('flex');
      }
    });

    links.forEach(link => {
      link.addEventListener('click', (e) => {
        const code = (e.currentTarget as HTMLElement).getAttribute('data-lang-code');
        if (code) {
          localStorage.setItem('preferred-lang', code);
        }
      });
    });
  });
</script>
