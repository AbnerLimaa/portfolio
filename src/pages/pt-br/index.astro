---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ id, data }) => !data.draft && id.endsWith('-pt-br'));
const allProjects = await getCollection('projects', ({ id, data }) => !data.draft && id.endsWith('-pt-br'));
const featuredProjects = allProjects.filter((entry) => entry.data.featured).slice(0, 4);
const sorted = [...allWork].sort((a, b) => {
  const aDate = a.data.endDate ? a.data.endDate.valueOf() : new Date().valueOf();
  const bDate = b.data.endDate ? b.data.endDate.valueOf() : new Date().valueOf();
  return bDate - aDate;
});
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-20 sm:pt-24">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      Atualmente construindo projetos open-source na Cajá Tech · disponível para novas oportunidades
    </p>

    <h1 class="font-display text-ink text-4xl leading-[1.1] font-medium sm:text-5xl">
      Especialista em arquitetura de software, sistemas distribuídos escaláveis e de alta performance.
    </h1>

    <p class="text-ink-soft mt-6 ">
      Engenheiro de Software Sênior — apaixonado por criar soluções de software robustas.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/pt-br/work" variant="solid">Veja meus trabalhos →</Button>
      <Button href="#contact" variant="ghost">Entre em contato</Button>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section id="projects" class="mx-auto max-w-5xl px-6 pb-20">
      <SectionHeading eyebrow="Projetos em Destaque" count={allProjects.length} />
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {featuredProjects.map((project) => (
          <a href={`/pt-br/projects/${project.id.replace('-pt-br', '')}`} class="border-line hover:border-signal block border p-6 sm:p-8 transition-colors">
            <div class="flex items-center gap-3">
              {project.data.icon && (
                <img src={project.data.icon} alt="" class="h-6 w-6" aria-hidden="true" />
              )}
              <h2 class="font-display text-ink text-xl">{project.data.title}</h2>
            </div>
            <p class="text-ink-soft mt-3 text-sm">{project.data.description}</p>
            <span class="text-signal mt-6 inline-block font-mono text-xs">Ver detalhes →</span>
          </a>
        ))}
      </div>
      {allProjects.length > featuredProjects.length && (
        <div class="mt-6">
          <a
            href="/pt-br/projects"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            Ver todos os {allProjects.length} projetos →
          </a>
        </div>
      )}
    </section>
  )}

  <section id="work" class="mx-auto max-w-5xl px-6 pb-20">
    <SectionHeading eyebrow="Trabalhos em destaque" count={allWork.length} />
    <div>
      {selected.map((entry) => <WorkRow entry={entry} />)}
    </div>
    {
      allWork.length > selected.length && (
        <div class="mt-6">
          <a
            href="/pt-br/work"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            Veja todos os {allWork.length} projetos →
          </a>
        </div>
      )
    }
  </section>

  <section id="about" class="mx-auto max-w-5xl px-6 pb-20">
    <SectionHeading eyebrow="Sobre Mim" />
    <p class="text-ink-soft ">
      Meu Portfólio — Engenheiro de Software especializado em arquitetura orientada a eventos, microsserviços e infraestrutura robusta em nuvem com experiência no mercado financeiro.
    </p>
    <a href="/pt-br/about" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
      Mais sobre meu trabalho →
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-5xl px-6 pb-24">
    <SectionHeading eyebrow="Vamos conversar" />
    <p class="font-display text-ink text-2xl sm:text-3xl">
      Sinta-se à vontade para entrar em contato.
    </p>
    <p class="text-ink-soft mt-4 ">
      Você pode me enviar um e-mail ou entrar em contato diretamente no <a href={SITE.social.find(s => s.label === 'LinkedIn')?.href} class="text-signal hover:underline" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
    </p>
    <!--email_off-->
    <a
      href={`mailto:contato@abnerlima.dev`}
      class="text-signal mt-6 inline-flex items-center gap-2 font-mono hover:underline"
    >
      contato@abnerlima.dev
    </a>
    <!--/email_off-->
  </section>
</BaseLayout>
