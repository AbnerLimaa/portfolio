---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { formatDate } from '@/utils/formatDate';

const posts = (await getCollection('blog', ({ id, data }) => !data.draft && id.endsWith('-pt-br'))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog" description="Escritos sobre engenharia de software e desenvolvimento.">
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="Blog" count={posts.length} />
    {posts.length === 0 ? (
      <div class="border-line mt-8 border border-dashed p-12 text-center">
        <p class="text-ink-soft text-sm">Ainda não há postagens no blog. Fique ligado!</p>
      </div>
    ) : (
      <div class="mt-8">
        {posts.map((post) => (
          <a
            href={`/pt-br/blog/${post.id.replace('-pt-br', '')}`}
            class="group border-line hover:border-signal grid grid-cols-[1fr_auto] items-center gap-4 border-b py-5 transition-colors sm:gap-6"
          >
            <article class="min-w-0">
              <p class="text-ink-soft font-mono text-xs mb-1">{formatDate(post.data.date, 'numeric', undefined, 'pt-BR')}</p>
              <h2 class="font-display text-ink group-hover:text-signal block truncate text-lg transition-colors">
                {post.data.title}
              </h2>
              <p class="text-ink-soft hidden truncate text-sm sm:block">{post.data.summary}</p>
            </article>

            <span class="flex items-center gap-4">
              <span
                aria-hidden="true"
                class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
              >
                →
              </span>
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
