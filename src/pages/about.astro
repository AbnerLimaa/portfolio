---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import coverImg from '@/assets/images/IMG_5429.jpeg';
import profileImg from '@/assets/images/IMG_4792.jpg';

import { SITE } from '@/site.config';

// Updated tech stack
const tools = [
  '.NET (C#)', 
  'Golang', 
  'AWS', 
  'Microservices', 
  'Docker', 
  'Kubernetes', 
  'PostgreSQL', 
  'Next.js', 
  'Kotlin',
  'RabbitMQ'
];
---

<BaseLayout title="About Me" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-5xl px-6 pt-8 pb-24 sm:pt-12">
    <!-- Landscape Cover Image -->
    <div class="w-full aspect-video rounded-xl overflow-hidden bg-surface">
      <Image src={coverImg} alt="Cover Image" class="w-full h-full object-cover" />
    </div>

    <!-- Profile Picture -->
    <div class="relative -mt-16 sm:-mt-20 mb-6 ml-4 sm:ml-8">
      <Image 
        src={profileImg} 
        alt="Profile" 
        class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover border-4 sm:border-[6px] border-paper bg-paper"
      />
    </div>

    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase mt-4">About Me</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I am a Software Engineer with solid experience building high-performance and scalable systems, primarily for the financial market. My special interest lies in event-driven architecture and microservices.
      </p>
      <p>
        In my professional journey, I've architected critical financial engines, prioritizing high availability and strict data precision. I enjoy tackling complex business rules and leveraging scalable cloud infrastructure to ensure seamless distributed processing.
      </p>
      <p>
        I hold a Bachelor's Degree in Computer Science from the Federal University of Ceará (UFC) in Brazil, which I completed in 2021.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tech Stack</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
