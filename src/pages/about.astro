---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

// Updated tech stack
const tools = [
  '.NET (C#)', 
  'Golang', 
  'AWS', 
  'Microservices', 
  'Docker', 
  'Kubernetes', 
  'PostgreSQL', 
  'Next.js', 
  'Kotlin',
  'RabbitMQ'
];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I am a Software Engineer with solid experience building high-performance and scalable systems, primarily for the financial market. My special interest lies in event-driven architecture and microservices.
      </p>
      <p>
        In my professional journey, I've architected critical financial engines, prioritizing high availability and strict data precision. I enjoy tackling complex business rules and leveraging scalable cloud infrastructure to ensure seamless distributed processing.
      </p>
      <p>
        I hold a Bachelor's Degree in Computer Science from the Federal University of Ceará (UFC) in Brazil, which I completed in 2021.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tech Stack</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
