---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ id, data }) => !data.draft && !id.endsWith('-pt-br'));
const allProjects = await getCollection('projects', ({ id, data }) => !data.draft && !id.endsWith('-pt-br'));
const featuredProjects = allProjects.filter((entry) => entry.data.featured).slice(0, 4);
const sorted = [...allWork].sort((a, b) => {
  const aDate = a.data.endDate ? a.data.endDate.valueOf() : new Date().valueOf();
  const bDate = b.data.endDate ? b.data.endDate.valueOf() : new Date().valueOf();
  return bDate - aDate;
});
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {SITE.status}
    </p>

    <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
      {SITE.tagline}
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      {SITE.role} — passionate about creating robust software solutions.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/work" variant="solid">View my work →</Button>
      <Button href="#contact" variant="ghost">Get in touch</Button>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section id="projects" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="Featured Projects" count={allProjects.length} />
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {featuredProjects.map((project) => (
          <a href={`/projects/${project.id}`} class="border-line hover:border-signal block border p-6 sm:p-8 transition-colors">
            <div class="flex items-center gap-3">
              {project.data.icon && (
                <img src={project.data.icon} alt="" class="h-6 w-6" aria-hidden="true" />
              )}
              <h2 class="font-display text-ink text-xl">{project.data.title}</h2>
            </div>
            <p class="text-ink-soft mt-3 text-sm">{project.data.description}</p>
            <span class="text-signal mt-6 inline-block font-mono text-xs">View details →</span>
          </a>
        ))}
      </div>
      {allProjects.length > featuredProjects.length && (
        <div class="mt-6">
          <a
            href="/projects"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            View all {allProjects.length} projects →
          </a>
        </div>
      )}
    </section>
  )}

  <section id="work" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="Selected work" count={allWork.length} />
    <div>
      {selected.map((entry) => <WorkRow entry={entry} />)}
    </div>
    {
      allWork.length > selected.length && (
        <div class="mt-6">
          <a
            href="/work"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            View all {allWork.length} projects →
          </a>
        </div>
      )
    }
  </section>

  <section id="about" class="mx-auto max-w-3xl px-6 pb-20">
    <SectionHeading eyebrow="About Me" />
    <p class="text-ink-soft max-w-xl">
      {SITE.description}
    </p>
    <a href="/about" class="text-signal mt-4 inline-block font-mono text-xs hover:underline">
      More about my work →
    </a>
  </section>

  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
    <SectionHeading eyebrow="Let's talk" />
    <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
      Feel free to reach out.
    </p>
    <p class="text-ink-soft mt-4 max-w-md">
      I'm always open to discussing and connecting with other professionals. You can send me an email or reach out directly on <a href={SITE.social.find(s => s.label === 'LinkedIn')?.href} class="text-signal hover:underline" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
    </p>
    <!--email_off-->
    <a
      href={`mailto:${SITE.email}`}
      class="text-signal mt-6 inline-flex items-center gap-2 font-mono hover:underline"
    >
      {SITE.email}
    </a>
    <!--/email_off-->
  </section>
</BaseLayout>
