---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const allWork = (await getCollection('work', ({ id, data }) => !data.draft && !id.endsWith('-pt-br'))).sort(
  (a, b) => {
    const aDate = a.data.endDate ? a.data.endDate.valueOf() : new Date().valueOf();
    const bDate = b.data.endDate ? b.data.endDate.valueOf() : new Date().valueOf();
    return bDate - aDate;
  }
);
---

<BaseLayout
  title="Work"
  description="Selected projects in software engineering."
>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <SectionHeading eyebrow="All work" count={allWork.length} />
    <div>
      {allWork.map((entry) => <WorkRow entry={entry} />)}
    </div>
  </section>
</BaseLayout>
